generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Temperature {
  HOT
  NORMAL
  CHILLED
}

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique
  description String?
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)

  menuItems   MenuItem[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model MenuItem {
  id             String          @id @default(uuid())
  name           String
  description    String          @db.Text

  categoryId     String
  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  temperature    Temperature     @default(NORMAL)
  spiceIndex     Int             @default(0)

  imageUrl       String?
  imagePublicId  String?

  isAvailable    Boolean         @default(true)
  sortOrder      Int             @default(0)

  servingOptions ServingOption[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([categoryId])
  @@index([isAvailable])
}

model ServingOption {
  id          String    @id @default(uuid())

  menuItemId  String
  menuItem    MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  label       String
  price       Decimal   @db.Decimal(10, 2)
  isAvailable Boolean   @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([menuItemId, label])
  @@index([menuItemId])
}

model ContactInquiry {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  message   String   @db.Text
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model Review {
  id         String   @id @default(uuid())
  /// Display name: first name only, or "A DOLCE customer" when the customer asked to stay anonymous.
  name       String
  rating     Int
  text       String   @default("") @db.Text
  /// Product the customer liked (from the Google Form).
  product    String?
  /// Customer permission to show this review: "first_name" | "anonymous" | "private".
  consent    String   @default("first_name")
  /// Where the review came from: "website" | "google_form".
  source     String   @default("website")
  /// Google Form response id, used to avoid importing the same response twice.
  externalId String?  @unique
  /// "Featured" on the website (chosen by the admin). Only allowed when consent is not "private".
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isApproved, createdAt])
}

/// Delivery & pickup settings edited in /dolceadmin (a single row with id "default").
model DeliverySettings {
  id            String   @id @default("default")
  /// "unset" (confirmed in chat) | "fixed" (one charge for the whole city) | "per_km"
  chargeMode    String   @default("unset")
  fixedFee      Decimal? @db.Decimal(10, 2)
  perKmRate     Decimal? @db.Decimal(10, 2)
  minimumCharge Decimal? @db.Decimal(10, 2)
  /// Orders at or above this amount get free delivery (null = no free-delivery offer).
  freeAbove     Decimal? @db.Decimal(10, 2)
  pickupEnabled Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}
