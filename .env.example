# WhatsApp number that receives orders (defaults to 9102518045 in src/lib/site.ts).
# A 10-digit Indian number gets +91 added automatically; otherwise include the country code.
# Used by every "Order on WhatsApp" button and the menu basket. Public by design (customers see it).
NEXT_PUBLIC_WHATSAPP_NUMBER="9102518045"

# PostgreSQL connection string used by the app. On Neon, use the *pooled* connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/dolce?schema=public"
# Optional: direct (non-pooled) connection string used for migrations. On Neon, the URL without "-pooler".
DIRECT_URL=""

# Long random secret used by protected admin API routes (Authorization: Bearer <token>).
ADMIN_API_TOKEN="replace-with-a-long-random-secret"

# Admin portal login (/dolceadmin).
# Generate the hash with: npm run admin:hash -- "your-password"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH=""
# Signs admin session cookies. At least 32 random characters, e.g. `openssl rand -base64 48`.
ADMIN_SESSION_SECRET="replace-with-at-least-32-random-characters"

# Cloudinary image upload for menu items (admin portal). Leave blank to paste image URLs instead.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
